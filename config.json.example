{
  "UseMySQL": true,

  "MySQL": {
    "Host": "",
    "Port": 3306,
    "User": "",
    "Password": "",
    "Database": "",
	"ConnectionLimit": 50
  },

  "SQLite": {
    "File": "./data/cloudstorage.db"
  },

  "Server": {
    "Port": 3005
  },

  "Auth": {
    "AllowClusterRegistration": false,
    "RegisterClusters": [
      { "ClusterId": "", "Secret": "" }
    ]
  },

  "Inventory": {
    "BatchWindowMs": 100
  },

  "AuditLog": {
    "RetentionDays": 3,
    "DiscordWebhook": ""
  },

  "Logging": {
    "Verbose": true
  }
}