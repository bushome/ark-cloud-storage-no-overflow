<configuration>
  <system.webServer>
    <!-- Handle Node.js files via iisnode -->
    <handlers>
      <add name="iisnode" path="dist/main.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- Rewrite URLs to the Node.js entry point -->
    <rewrite>
      <rules>
        <!-- Static files are served directly -->
        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}" />
        </rule>

        <!-- All other requests go to server.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="dist/main.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Optional: iisnode specific settings -->
    <iisnode watchedFiles="web.config;*.js" loggingEnabled="true" logDirectory="iisnode" devErrorsEnabled="true" />
  </system.webServer>
</configuration>